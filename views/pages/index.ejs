    <!-- ==========================================================================
       5. ABOUT US & CONTACT US SECTION
       ========================================================================== -->
    <section class="about-contact-section" id="about">
      <div class="container about-contact-split">
        <!-- Left Side: About Us -->
        <div class="about-col reveal">
          <span>Who We Are</span>
          <h3>Posh Limousines of Atlanta</h3>
          <p>
            Posh Limousines of Atlanta is a premier transportation provider
            dedicated to delivering exceptional black SUV chauffeur services. We
            specialize in point-to-point transfers, hourly charters, airport
            luxury transit, and customizable packages for formal celebrations.
          </p>
          <p>
            Our operation is strictly professional, utilizing a late-model fleet
            of immaculate black Cadillac Escalades and Lincoln Navigators. Every
            driver is vetting-cleared, background-checked, and highly trained in
            client etiquette and route efficiency.
          </p>
          <ul class="about-features">
            <li>
              <svg viewBox="0 0 24 24">
                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
              </svg>
              <span>Late-model premium Cadillac and Lincoln SUVs</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24">
                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
              </svg>
              <span>Fully licensed, certified, and commercially insured</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24">
                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
              </svg>
              <span>Professional chauffeurs in executive suit attire</span>
            </li>
          </ul>
        </div>

        <!-- Right Side: Contact / Book Your Ride -->
        <div class="contact-col reveal" id="contact">
          <h3>Book Your Ride</h3>
          <p>
            Fill out the details below to request a quote or confirm a booking.
            We will follow up immediately.
          </p>

          <!-- Web3Forms Integration -->
          <form
            action="https://api.web3forms.com/submit"
            method="POST"
            id="contact-form"
            class="contact-form"
          >
            <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
            <input type="hidden" name="subject" value="New Ride Booking Request - Posh Limousines" />
            <input type="checkbox" name="botcheck" class="hidden" style="display: none" />

            <div class="form-group">
              <label for="form-name">Full Name</label>
              <input type="text" name="name" id="form-name" placeholder="John Doe" required />
            </div>

            <div class="form-row-2">
              <div class="form-group">
                <label for="form-email">Email Address</label>
                <input type="email" name="email" id="form-email" placeholder="john@example.com" required />
              </div>
              <div class="form-group">
                <label for="form-phone">Phone Number</label>
                <input type="tel" name="phone" id="form-phone" placeholder="(404) 555-0199" required />
              </div>
            </div>

            <div class="form-row-2">
              <div class="form-group">
                <label for="form-service">Required Service</label>
                <select name="service_type" id="form-service" required>
                  <option value="" disabled selected>Select a Service</option>
                  <option value="Airport Pickups">Airport Pickups</option>
                  <option value="Formal Celebrations">Formal Celebrations</option>
                  <option value="Safe Driver Pickup">Safe Driver Pickup</option>
                  <option value="Casual Events">Casual Events</option>
                  <option value="Corporate Events">Corporate Events</option>
                </select>
              </div>
              <div class="form-group">
                <label for="form-date">Pickup Date</label>
                <input type="date" name="pickup_date" id="form-date" required />
              </div>
            </div>

            <div class="form-group">
              <label for="form-message">Special Instructions / Routing Details</label>
              <textarea
                name="message"
                id="form-message"
                placeholder="Provide details such as pickup/drop-off addresses, flight numbers, or special timing preferences."
                required
              ></textarea>
            </div>

            <button type="submit" class="btn" id="form-submit-btn">Send Booking Request</button>
            <div id="form-response-msg" class="form-message"></div>
          </form>
        </div>
      </div>
    </section>

