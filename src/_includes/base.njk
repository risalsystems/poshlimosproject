<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title }}</title>

    <!-- Meta Descriptions for SEO -->
    <meta name="description" content="{{ description }}" />
    {% if keywords %}
    <meta name="keywords" content="{{ keywords }}" />
    {% endif %}
    <meta name="author" content="Posh Limousines of Atlanta" />
    {% if canonical %}
    <link rel="canonical" href="{{ canonical }}" />
    {% endif %}

    <!-- Apple Webkit Meta Configuration -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Posh Limos" />
    <link rel="apple-touch-icon" href="assets/hero_atlanta.png" />

    <!-- Open Graph Protocol (OG) Metadata -->
    <meta property="og:title" content="{{ ogTitle if ogTitle else title }}" />
    <meta property="og:description" content="{{ ogDescription if ogDescription else description }}" />
    <meta property="og:image" content="{{ ogImage if ogImage else 'assets/hero_atlanta.png' }}" />
    <meta property="og:url" content="{{ canonical if canonical else 'https://www.poshlimosatlanta.com' }}" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Posh Limousines of Atlanta" />

    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ ogTitle if ogTitle else title }}" />
    <meta name="twitter:description" content="{{ ogDescription if ogDescription else description }}" />
    <meta name="twitter:image" content="{{ ogImage if ogImage else 'assets/hero_atlanta.png' }}" />

    <!-- Primary Stylesheet -->
    <link rel="stylesheet" href="style.css" />

    {% if isHomePage %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Posh Limousines of Atlanta",
        "image": "assets/hero_atlanta.png",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "123 Main St",
          "addressLocality": "Atlanta",
          "addressRegion": "GA",
          "postalCode": "30303",
          "addressCountry": "US"
        },
        "telephone": "+1-123-456-7890",
        "url": "https://www.poshlimosatlanta.com",
        "areaServed": "Atlanta Metropolitan Area"
      }
    </script>
    {% endif %}
  </head>
  <body>
    {% include "navbar.njk" %}

    {{ content | safe }}

    {% include "footer.njk" %}

    <script src="script.js"></script>
  </body>
</html>
